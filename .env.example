# DataOS — copy to .env and fill in before deploying. Never commit .env.

# --- Runtime security (required in production) ---
# Sharing-token signing secret (>=32 UTF-8 bytes). Required for /api/sharing/*.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATAOS_SHARING_TOKEN_SECRET=

# Production API bearer token (>=32 UTF-8 bytes). Required when DATAOS_ENV=production.
DATAOS_API_TOKEN=

# High-risk opt-in: allows /api/compute/python and query_type=python in production.
# Keep false unless sandbox + access controls have been reviewed.
DATAOS_ALLOW_PYTHON_COMPUTE=false

# Per-user auth signing secret (>=32 UTF-8 bytes). Required for /api/auth/* in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATAOS_JWT_SECRET=

# --- Environment markers ---
DATAOS_ENV=development
APP_ENV=development
ENVIRONMENT=development

# --- Request limits ---
# Maximum HTTP request body in bytes (default 50 MiB; allowed range 1 KiB?256 MiB).
DATAOS_MAX_REQUEST_BODY_BYTES=52428800

# --- CORS (comma-separated exact origins; empty = deny cross-origin) ---
DATAOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage ---
DATAOS_DB_PATH=dataos.db
DATAOS_BLOB_DIR=.dataos_blobs
# DATABASE_URL=postgresql://user:pass@host:5432/db   # optional; omit for SQLite default
